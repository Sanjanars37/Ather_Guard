# GEMINI_API_KEY: Required for the Survival Orchestrator and Relief Agent.
# Read server-side only by api/survival-plan.ts and api/relief-recommendation.ts
# — never exposed to the browser. Get a free-tier key at https://aistudio.google.com/apikey
# For local dev: copy this file to .env and fill in your key, then run `vercel dev`.
# For production: set this in the Vercel project's Environment Variables settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
