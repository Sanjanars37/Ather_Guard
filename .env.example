# GEMINI_API_KEY: Required for Gemini AI API calls.
# Read server-side only by api/generate-image.ts — never exposed to the browser.
# For local dev: copy this file to .env and fill in your key, then run `vercel dev`.
# For production: set this in the Vercel project's Environment Variables settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
